# Copy to .env and fill in. .env is not committed.

# --- Application ---
# Host used for links in notification emails
APP_HOST=localhost:3000
APP_PROTOCOL=http
# Set to /watch when the production reverse proxy mounts the app under that path.
RAILS_RELATIVE_URL_ROOT=

# --- Database (production) ---
VULN_WATCH_DATABASE_PASSWORD=

# --- CVE List (CVEProject/cvelistV5) ---
CVELIST_REPO_URL=https://github.com/CVEProject/cvelistV5.git
# Local clone used for git fetch / diff
CVELIST_PATH=vendor/cvelist

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=
# Request timeout in seconds
OPENAI_TIMEOUT=60

# --- Mail (SMTP) ---
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USER_NAME=
SMTP_PASSWORD=
# plain / login / cram_md5
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

MAIL_FROM=vuln-watch@example.com
# Comma-separated list of recipients for emergency notifications
MAIL_TO=security@example.com
