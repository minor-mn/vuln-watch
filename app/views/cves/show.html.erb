<% content_for :title, "#{@cve.identifier} - Vuln Watch" %>

<div class="space-y-6">
  <div>
    <%= link_to "← 一覧", root_path, class: "text-sm text-sky-700 hover:underline" %>
    <h1 class="mt-2 font-mono text-2xl font-semibold"><%= @cve.identifier %></h1>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
      <%= judgement_badge(@cve.current_judgement) %>
      <%= possible_match_badge if @cve.possible_match? %>
      <%= mismatch_badge if @cve.assessment_mismatch? %>
      <span class="text-gray-500">公開 <%= format_time(@cve.date_published) %> ・ 更新 <%= format_time(@cve.record_date_updated) %></span>
    </div>
  </div>

  <section class="rounded border border-gray-200 bg-white p-4">
    <h2 class="mb-3 font-semibold">判定</h2>
    <dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-2 text-sm">
      <dt class="text-gray-500">現在の判定</dt>
      <dd><%= judgement_badge(@cve.current_judgement) %></dd>
      <% if (previous = @cve.previous_judgement_result) %>
        <dt class="text-gray-500">以前の判定</dt>
        <dd><%= judgement_badge(previous) %></dd>
      <% end %>
      <% if @judgement %>
        <dt class="text-gray-500">攻撃条件</dt>
        <dd><%= CvesHelper::CONDITION_LABELS[@judgement.attack_condition] %>（AV・PR・UI がすべて N か）</dd>
        <dt class="text-gray-500">攻撃能力</dt>
        <dd><%= CvesHelper::CONDITION_LABELS[@judgement.capability_condition] %>（RCE・認証回避・シェル取得・root 取得のいずれか）</dd>
        <dt class="text-gray-500">根拠</dt>
        <dd><%= judgement_basis(@judgement) %></dd>
      <% end %>
      <% if @cve.notification&.sent_at %>
        <dt class="text-gray-500">メール通知</dt>
        <dd><%= format_time(@cve.notification.sent_at) %> に送信済み</dd>
      <% end %>
    </dl>
  </section>

  <section class="rounded border border-gray-200 bg-white p-4">
    <h2 class="mb-3 font-semibold">解説</h2>
    <% if @analysis %>
      <dl class="space-y-3 text-sm">
        <% { "概要" => @analysis.summary_overview, "影響" => @analysis.summary_impact,
             "対象" => @analysis.summary_affected, "対策" => @analysis.summary_mitigation }.each do |heading, body| %>
          <div>
            <dt class="font-medium text-gray-700"><%= heading %></dt>
            <dd class="mt-1 whitespace-pre-line"><%= body.presence || "-" %></dd>
          </div>
        <% end %>
        <div>
          <dt class="font-medium text-gray-700">判定</dt>
          <dd class="mt-1"><%= judgement_basis(@judgement) %></dd>
        </div>
        <div>
          <dt class="font-medium text-gray-700">出典</dt>
          <dd class="mt-1">
            <ul class="list-disc space-y-1 pl-5">
              <li><%= link_to "CVE.org: #{@cve.identifier}", "https://www.cve.org/CVERecord?id=#{@cve.identifier}", class: "text-sky-700 hover:underline", rel: "noopener noreferrer" %></li>
              <% @record&.references&.each do |reference| %>
                <li class="break-all"><%= link_to reference["name"].presence || reference["url"], reference["url"], class: "text-sky-700 hover:underline", rel: "noopener noreferrer" %></li>
              <% end %>
            </ul>
          </dd>
        </div>
      </dl>
    <% else %>
      <p class="text-sm text-gray-500">解説はまだ生成されていません。</p>
    <% end %>
  </section>

  <section class="rounded border border-gray-200 bg-white p-4">
    <h2 class="mb-3 flex items-center gap-2 font-semibold">CVSS 評価 <%= mismatch_badge if @cve.assessment_mismatch? %></h2>
    <% if @assessments_by_source.values.flatten.empty? %>
      <p class="text-sm text-gray-500">CVSS v3.0 以降の評価はまだ付いていません。</p>
    <% else %>
      <table class="min-w-full text-sm">
        <thead class="text-left text-xs text-gray-500">
          <tr><th class="py-1 pr-4 font-medium">出所</th><th class="py-1 pr-4 font-medium">版</th><th class="py-1 pr-4 font-medium">AV / PR / UI</th><th class="py-1 pr-4 font-medium">ベクトル</th><th class="py-1 font-medium">出所側の更新日時</th></tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @assessments_by_source.each do |source, assessments| %>
            <% assessments.sort_by { |a| CvssAssessment::VERSIONS.index(a.version) }.each do |assessment| %>
              <tr class="<%= 'bg-sky-50' if assessment == @judgement&.selected_assessment %>">
                <td class="py-1 pr-4"><%= source_label(source) %><%= tag.span("（採用）", class: "text-xs text-sky-700") if assessment == @judgement&.selected_assessment %></td>
                <td class="py-1 pr-4"><%= assessment.version %></td>
                <td class="py-1 pr-4 font-mono text-xs"><%= assessment_vector(assessment) %></td>
                <td class="break-all py-1 pr-4 font-mono text-xs text-gray-600"><%= assessment.vector_string %></td>
                <td class="whitespace-nowrap py-1 text-gray-600"><%= format_time(assessment.source_revision.source_date_updated) %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <% if @analysis %>
    <section class="rounded border border-gray-200 bg-white p-4">
      <h2 class="mb-3 font-semibold">攻撃能力（AI 判定）</h2>
      <table class="mb-3 text-sm">
        <tbody>
          <% @analysis.capability_values.each do |capability, value| %>
            <tr>
              <td class="py-0.5 pr-6 text-gray-600"><%= CvesHelper::CAPABILITY_LABELS[capability.to_s] %></td>
              <td class="py-0.5"><%= CvesHelper::TRI_STATE_LABELS[value] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @analysis.evidence.any? %>
        <h3 class="mb-1 text-sm font-medium text-gray-700">根拠</h3>
        <ul class="space-y-2 text-sm">
          <% @analysis.evidence.each do |evidence| %>
            <li>
              <span class="text-gray-600"><%= CvesHelper::CAPABILITY_LABELS[evidence["capability"]] %> ・ <%= evidence["source"] %></span>
              <blockquote class="mt-0.5 border-l-2 border-gray-300 pl-3 text-gray-700"><%= evidence["quote"] %></blockquote>
            </li>
          <% end %>
        </ul>
      <% end %>
      <p class="mt-3 text-xs text-gray-500">
        モデル <%= @analysis.model %> ・ プロンプト <%= @analysis.prompt_version %> ・ <%= format_time(@analysis.analyzed_at) %> ・ 入力 SHA-256 <span class="font-mono"><%= @analysis.input_hash.first(12) %></span>
      </p>
    </section>
  <% end %>

  <section class="rounded border border-gray-200 bg-white p-4">
    <h2 class="mb-3 font-semibold">一致した監視対象製品</h2>
    <ul class="space-y-3 text-sm">
      <% @cve.product_matches.each do |match| %>
        <li>
          <div>
            <span class="font-medium"><%= match.product_name %></span>
            <span class="text-gray-600">— <%= CvesHelper::RULE_LABELS[match.rule] %>で一致</span>
            <% if match.by_description? && match.ai_affects_product %>
              <span class="text-gray-600">（AI の判定: 影響を受けるか <%= CvesHelper::TRI_STATE_LABELS[ProductMatch.ai_affects_products[match.ai_affects_product]] %>）</span>
            <% end %>
          </div>
          <div class="mt-1 border-l-2 border-gray-200 pl-3">
            <p class="text-gray-800"><%= match.matched_text %></p>
            <% if match.matched_text_ja.present? %>
              <p class="mt-1 text-gray-600"><%= match.matched_text_ja %></p>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="rounded border border-gray-200 bg-white p-4">
    <h2 class="mb-3 font-semibold">変更履歴</h2>
    <% if @judgements.empty? %>
      <p class="text-sm text-gray-500">まだ判定していません。</p>
    <% else %>
      <ol class="space-y-3 text-sm">
        <% @judgements.each do |judgement| %>
          <li class="flex gap-4">
            <span class="whitespace-nowrap text-gray-500"><%= format_time(judgement.effective_at) %></span>
            <div>
              <ul>
                <% judgement.changes_summary.each do |change| %>
                  <li><%= change_description(change) %></li>
                <% end %>
              </ul>
              <div class="text-xs text-gray-500">→ <%= judgement_label(judgement.result) %></div>
            </div>
          </li>
        <% end %>
      </ol>
    <% end %>
  </section>
</div>
