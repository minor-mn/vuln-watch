<% if items.any? %>
  <div class="mt-3 space-y-3">
    <% items.each do |item| %>
      <article class="rounded border border-gray-200 bg-white px-4 py-3">
        <h3>
          <% if item.source == "full_disclosure" %>
            <%= link_to item.title, full_disclosure_path(item), class: "font-medium text-sky-700 hover:underline" %>
          <% else %>
            <%= link_to item.title, item.url, class: "font-medium text-sky-700 hover:underline", target: "_blank", rel: "noopener noreferrer" %>
          <% end %>
        </h3>
        <% if item.source == "full_disclosure" %>
          <div class="mt-1 space-y-1 text-xs" aria-label="AV / PR / UI（AI判定）">
            <% assessments = full_disclosure_assessments[item.id] %>
            <% if assessments.present? %>
              <% assessments.each do |assessment| %>
                <p>
                  <% if assessments.many? %><span class="text-gray-600"><%= assessment.fetch("subject") %>：</span><% end %>
                  <span class="font-mono"><%= full_disclosure_metric_vector(assessment) %></span>
                  <span class="text-gray-500">（AI判定）</span>
                </p>
              <% end %>
            <% else %>
              <p class="text-gray-500">AV / PR / UI：解析待ち</p>
            <% end %>
          </div>
        <% end %>
        <% if item.source != "slashdot" && item.cve_identifiers.any? { |identifier| related_cves.key?(identifier) } %>
          <div class="mt-1 text-xs text-gray-500">関連CVE：<%= judgement_badge(item.section(related_cves)) %></div>
        <% end %>
        <p class="mt-1 text-sm"><%= item.summary.presence || item.title %></p>
        <p class="mt-1 text-xs text-gray-500"><%= InformationSources::LABELS.fetch(item.source) %> · <%= format_time(item.published_at) %></p>
      </article>
    <% end %>
  </div>
<% end %>
