<% content_for :title, "Vuln Watch" %>

<div class="space-y-8">
  <% if @selected_sources.include?("cve") %>
  <section id="cve">
    <h2 class="mb-2 text-base font-semibold">CVE <span class="text-sm font-normal text-gray-500"><%= @sections.values.sum { |section| section.fetch(:total) } %> 件</span></h2>
    <div class="space-y-8">
  <% @sections.each do |result, section| %>
    <% cves = section.fetch(:cves) %>
    <section id="<%= result %>">
      <h3 class="mb-2 flex items-center gap-2 text-base font-semibold">
        <%= judgement_badge(result) %>
        <span class="text-sm font-normal text-gray-500"><%= section.fetch(:total) %> 件</span>
      </h3>

      <% if cves.empty? %>
        <p class="rounded border border-dashed border-gray-300 bg-white px-4 py-3 text-sm text-gray-500">該当する CVE はありません。</p>
      <% else %>
        <div class="overflow-x-auto rounded border border-gray-200 bg-white">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-left text-xs text-gray-500">
              <tr>
                <th class="px-3 py-2 font-medium">CVE</th>
                <th class="px-3 py-2 font-medium">製品</th>
                <th class="px-3 py-2 font-medium">採用評価</th>
                <th class="px-3 py-2 font-medium">攻撃能力</th>
                <th class="px-3 py-2 font-medium">公開日</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% cves.each do |cve| %>
                <% judgement = cve.latest_judgement %>
                <% assessment = judgement&.selected_assessment %>
                <tr class="align-top">
                  <td class="whitespace-nowrap px-3 py-2">
                    <%= link_to cve.identifier, cve_path(cve), class: "font-mono text-sky-700 hover:underline" %>
                  </td>
                  <td class="px-3 py-2">
                    <div><%= @products_by_cve.fetch(cve.id, []).join(", ").presence || "記載なし" %></div>
                    <div class="mt-1 flex flex-wrap gap-1">
                      <%= possible_match_badge if cve.possible_match? %>
                      <%= mismatch_badge if cve.assessment_mismatch %>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2 font-mono text-xs">
                    <% if assessment %>
                      <%= assessment_vector(assessment) %>
                      <div class="text-gray-500"><%= assessment_origin(assessment.source, assessment.version) %></div>
                    <% else %>
                      <span class="text-gray-400">なし</span>
                    <% end %>
                  </td>
                  <td class="px-3 py-2">
                    <%= found_capabilities(judgement&.ai_analysis).join(" / ").presence || tag.span("-", class: "text-gray-400") %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2 text-gray-600"><%= format_time(cve.date_published) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if section.fetch(:total_pages) > 1 %>
          <div class="mt-3 flex items-center justify-between text-sm text-gray-600">
            <span>
              <%= (section.fetch(:page) - 1) * CvesController::PAGE_SIZE + 1 %>–<%= [ section.fetch(:page) * CvesController::PAGE_SIZE, section.fetch(:total) ].min %>
              / CVE <%= section.fetch(:total) %> 件（<%= section.fetch(:page) %> / <%= section.fetch(:total_pages) %> ページ）
            </span>
            <nav class="flex items-center gap-3" aria-label="<%= judgement_label(result) %>のページ">
              <% if section.fetch(:page) > 1 %>
                <%= link_to "前へ", listing_page_path("#{result}_page", section.fetch(:page) - 1, anchor: result), class: "text-sky-700 hover:underline" %>
              <% end %>
              <% if section.fetch(:page) < section.fetch(:total_pages) %>
                <%= link_to "次へ", listing_page_path("#{result}_page", section.fetch(:page) + 1, anchor: result), class: "text-sky-700 hover:underline" %>
              <% end %>
            </nav>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>
    </div>
  </section>
  <% end %>
  <% @information_sections.each do |source, section| %>
  <section id="<%= source %>">
    <h2 class="mb-2 text-base font-semibold"><%= information_source_label(source) %> <span class="text-sm font-normal text-gray-500"><%= section.fetch(:total) %> 件</span></h2>
    <%= render "information_items", items: section.fetch(:items), related_cves: @related_cves, full_disclosure_assessments: @full_disclosure_assessments %>
    <% if section.fetch(:items).empty? %>
      <p class="rounded border border-dashed border-gray-300 bg-white px-4 py-3 text-sm text-gray-500">該当する情報はありません。</p>
    <% else %>
      <%= render "information_pagination", source:, section: %>
    <% end %>
  </section>
  <% end %>
</div>
