[Unit]
Description=vuln-watch Rails application
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=vulnwatch
Group=vulnwatch
WorkingDirectory=/srv/vuln-watch/current
EnvironmentFile=/srv/vuln-watch/shared/app.env
EnvironmentFile=/etc/vuln-watch/database.env
EnvironmentFile=/etc/vuln-watch/rails.env
EnvironmentFile=-/etc/vuln-watch/runtime.env
Environment=RAILS_ENV=production
Environment=RAILS_LOG_TO_STDOUT=1
Environment=RAILS_SERVE_STATIC_FILES=true
Environment=APP_HOST=an.umr.biz
Environment=APP_PROTOCOL=https
Environment=PORT=3000
Environment=BUNDLE_WITHOUT=development:test
Environment=BUNDLE_PATH=/srv/vuln-watch/shared/bundle
Environment=PATH=/opt/ruby-3.3.12/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/opt/ruby-3.3.12/bin/bundle exec rails db:prepare
ExecStart=/opt/ruby-3.3.12/bin/bundle exec puma -C config/puma.rb
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/vuln-watch

[Install]
WantedBy=multi-user.target
